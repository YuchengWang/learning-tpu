# --- ☁️ Google Cloud Platform Configuration ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

VERTEXAI_PROJECT_ID=your-gcp-project-id
VERTEXAI_LOCATION=us-central1
VERTEXAI_GEMINI_MODEL=gemini-3-pro-preview

# Path to your Google Cloud Service Account JSON key (DO NOT COMMIT THE ACTUAL KEY)
GOOGLE_APPLICATION_CREDENTIALS="./your-service-account-key.json"

# --- 🚀 Hugging Face Authentication ---
HF_TOKEN="your_huggingface_access_token"

# --- ⚙️ TPU Provisioning & Runtime Settings ---
PROJECT_ID="your-gcp-project-id"
ZONE="us-central1-a"
ACCELERATOR_TYPE="v6e-1"
RUNTIME_VERSION="v2-alpha-tpuv6e"

# JAX / XLA memory & execution configuration (for JAX-based workloads)
XLA_USE_BF16=1
JAX_PLATFORMS="tpu,cpu"
XLA_PYTHON_CLIENT_PREALLOCATE="false"
XLA_PYTHON_CLIENT_MEM_FRACTION=".80"
XLA_PYTHON_CLIENT_ALLOCATOR="platform"
